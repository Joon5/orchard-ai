{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard (project "orchard-ai")
  "name": "orchard-ai",
  "compatibility_date": "2026-06-01",
  // Static-assets-only Worker: serves the Next.js static export, no server code
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
